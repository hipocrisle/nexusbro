# TEMPLATE ONLY: select a separate hostname and certificate before installing.
# Do not edit any existing SSH/VPN/public proxy virtual host.
server {
    listen 443 ssl;
    server_name browser-sync.example.invalid;
    ssl_certificate /etc/letsencrypt/live/browser-sync.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/browser-sync.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4m;
    location / {
        proxy_pass http://127.0.0.1:8796;
        proxy_set_header Host $host;
        # Overwrite client-supplied forwarding headers; backend trusts loopback only.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
