{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexusBro",
  "version": "0.1.5",
  "identifier": "org.hipogas.nexusbro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NexusBro",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "chromium/": "chromium",
      "binaries/*": "binaries/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCNzg3QjA1Q0E0QjQ4QUUKUldTdVNFdktCWHQ0MjR2NGlnOHp6TytQQkN3aG1mcjltNVNFTDJ0QWFmK2NRdW42blkwaVV3MXYK",
      "endpoints": [
        "https://github.com/hipocrisle/nexusbro/releases/latest/download/latest.json"
      ]
    }
  }
}